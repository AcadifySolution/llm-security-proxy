APP_ENV=development
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Client authentication. Leave empty only for local development.
REQUIRE_API_KEY=true
PROXY_API_KEY=

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=

REDACT_PII=true
PII_ENTITIES_TO_FILTER=EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD,IP_ADDRESS
PII_REDACTION_PLACEHOLDER=[REDACTED]

ENABLE_GUARDRAILS=true
MAX_PROMPT_TOKENS=4096
MAX_MESSAGES=100
MAX_MESSAGE_CHARS=200000
MAX_REQUEST_BODY_BYTES=1000000

AUDIT_LOG_PATH=/var/log/llm-security-proxy/audit.log
SIGN_AUDIT_LOGS=false
LOG_SIGNING_KEY=
